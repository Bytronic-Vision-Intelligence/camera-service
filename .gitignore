# Python
*.pyc
__pycache__/
*.egg-info/

# Virtualenvs. service-orchestrator expects one per service at <repo>/.venv
.venv/
venv/

# Config written into this repo's root by service-orchestrator at startup.
# Never commit these: a stale copy would overwrite a live deployment config.
/config.yaml
/config-*.yaml

# Captured and archived imagery
*.png
*.jpg
*archive
save_dir/
persist.json

# Test output
junit/
.pytest_cache/
.ruff_cache/
docs/superpowers/
.vscode/
.idea/
.claude/
.DS_Store

*.log

# act run byproducts (docker-local/run.sh)
docker-local/logs/
docker-local/artifacts/

# Clean tree built by docker-local/run.sh --release
docker-local/.tree/
docker-local/.release-check/

# Release build output. The release workflow writes binaries to dist/ and zips
# to upload/; anything that runs it outside CI leaves them in the working tree,
# where `git add -A` would commit a 12MB binary. Pinned by
# test/test_release_pipeline.py::test_the_release_output_paths_are_gitignored
dist/
upload/
